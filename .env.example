# Copy to .env and run npm run analysis:env. This file contains no credentials.
# Demo mode never contacts a model provider.
WAC_ANALYSIS_MODE=demo
WAC_ANALYSIS_PORT=8787
WAC_ANALYSIS_HOURLY_LIMIT=30

# Additional allowed Chrome extension IDs, separated by commas.
# The development ID is derived from manifest.json automatically.
# This public ID belongs to the WAC Chrome Web Store item.
WAC_EXTENSION_IDS=jemkcnfiakblmlfoefjenckljbcngeoj

# Set both values and change WAC_ANALYSIS_MODE to gemini for real analysis.
# GEMINI_API_KEY=
# GEMINI_MODEL=
